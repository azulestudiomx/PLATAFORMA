generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  role      String   @default("CAPTURIST")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id             String    @id @default(uuid())
  municipio      String?
  comunidad      String?
  lat            Float?
  lng            Float?
  needType       String?
  description    String?
  evidenceBase64 String?
  evidenceGallery String?
  evidenceUrl    String?
  timestamp      Float?
  user           String?
  status         String    @default("Pendiente")
  syncedAt       DateTime  @default(now())
  customData     String?
  response       String?
  resolvedAt     DateTime?
  sentiment      String?
  urgency        String?
  assignedTo     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  history        ReportHistory[]

  @@index([status])
  @@index([needType])
  @@index([municipio])
  @@index([timestamp])
  @@index([user])
  @@index([assignedTo])
}

model ReportHistory {
  id         String   @id @default(uuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  username   String?
  action     String   // STATUS_CHANGE, ASSIGNED, COMMENT, EDIT
  fromStatus String?
  toStatus   String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([reportId])
}

model Person {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  address   String?
  municipio String?
  localidad String?
  distrito  String?
  zona      String?
  seccion   String?
  ine       String?  @unique
  email     String?
  birthday  String?
  photo     String?
  inePhoto  String?
  lat       Float?
  lng       Float?
  synced    Int      @default(1)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seccion])
  @@index([municipio])
  @@index([localidad])
  @@index([createdBy])
}


model Event {
  id          String   @id @default(uuid())
  title       String
  date        String
  location    String?
  community   String?
  type        String   @default("Reunión") // Reunión, Visita, Jornada, Mitin
  description String?
  assignedTo  String?  // Comma separated users or JSON
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  username  String?
  role      String?
  action    String   // CREATE, UPDATE, DELETE, LOGIN
  entity    String   // Person, Report, Event, User, SystemConfig
  entityId  String?
  detail    String?  // resumen legible del cambio
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([username])
  @@index([createdAt])
}

model SystemConfig {
  id           String @id @default(uuid())
  primaryColor String @default("#8B0000")
  secondaryCol String @default("#FFFFFF")
  accentColor  String @default("#FFD700")
  needTypes    String @default("[\"Agua Potable\", \"Luz Eléctrica\", \"Drenaje\", \"Salud\", \"Educación\", \"Seguridad\", \"Otro\"]")
  eventTypes   String @default("[\"Jornada de Captura\", \"Visita de Campo\", \"Reunión Vecinal\", \"Entrega de Apoyo\"]")
  customFields String @default("[]")
}
