# Copia este archivo a .env y llena los valores reales.
# NUNCA subas el .env real a git.

# Obligatorio. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3003

# Base de datos SQLite (Prisma). La ruta es relativa a server/prisma/
DATABASE_URL="file:./dev.db"

# Orígenes permitidos para CORS en producción (separados por coma).
# Vacío = permite cualquier origen (solo para desarrollo).
CORS_ORIGIN=

# Opcional: análisis de reportes con IA
GEMINI_API_KEY=

# Opcional: subida de evidencias fotográficas
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
